{
  "name": "namelessrealms-api",
  "version": "1.6.2",
  "description": "Nameless Realms API Service",
  "main": "./build/index.js",
  "scripts": {
    "start": "cross-env NODE_ENV=production node ./dist/index.js",
    "dev": "cross-env NODE_ENV=development ts-node-dev --respawn --watch --files -- ./src/index.ts",
    "build": "yarn outputVersion && yarn buildDir && tsc",
    "buildDir": "node build.js",
    "outputVersion": "node -p \"'export const API_VERSION = ' + JSON.stringify(require('./package.json').version) + ';'\" > src/version.ts"
  },
  "author": "Quasi",
  "license": "GPL-3.0",
  "dependencies": {
    "argon2": "^0.44.0",
    "cheerio": "^1.0.0-rc.10",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.6",
    "cross-env": "^7.0.3",
    "csurf": "^1.11.0",
    "dotenv": "^17.3.1",
    "ejs": "^3.1.6",
    "express": "^5.2.1",
    "express-mysql-session": "^2.1.6",
    "express-session": "^1.17.2",
    "form-data": "^4.0.0",
    "fs-extra": "^11.3.3",
    "got": "^11.8.2",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.1",
    "multer": "^1.4.4",
    "mysql2": "^3.17.1",
    "nodemailer": "^8.0.1",
    "socket.io": "^4.8.3",
    "swagger-jsdoc": "^6.2.8",
    "swagger-ui-express": "^5.0.1",
    "tslib": "^2.3.1",
    "uniqid": "^5.3.0"
  },
  "devDependencies": {
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/csurf": "^1.11.2",
    "@types/express": "^5.0.6",
    "@types/express-mysql-session": "^2.1.3",
    "@types/express-session": "^1.17.4",
    "@types/fs-extra": "^11.0.4",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/multer": "^1.4.7",
    "@types/mysql2": "github:types/mysql2",
    "@types/node": "^25.2.3",
    "@types/nodemailer": "^7.0.10",
    "@types/swagger-jsdoc": "^6.0.4",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/uniqid": "^5.3.1",
    "@types/ws": "^8.18.1",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.9.3"
  }
}
